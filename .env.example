INSFORGE_BASE_URL=https://your-project.insforge.app
INSFORGE_API_KEY=your-server-only-api-key
TELEGRAM_BOT_TOKEN=123456789:telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=generate-a-long-random-secret
TELEGRAM_ALLOWED_CHAT_ID=123456789
OPENAI_API_KEY=optional-for-natural-language-agent
OPENAI_MODEL=gpt-4o-mini
HEALTH_SYNC_TOKEN=generate-a-long-random-health-sync-token
DASHBOARD_READ_TOKEN=generate-a-long-random-read-token
DASHBOARD_TOGGLE_TOKEN=generate-a-long-random-toggle-token

# Optional integrations. Server-only OAuth values; never copy these to the Kindle.
DASHBOARD_TIMEZONE=UTC
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
GOOGLE_HEALTH_REFRESH_TOKEN=
GOOGLE_HEALTH_TIMEZONE=UTC
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
